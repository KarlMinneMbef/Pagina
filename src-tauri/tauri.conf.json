{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pagina",
  "version": "0.4.8",
  "identifier": "fr.mbef.xmd-editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pagina — Mon BE Fluides",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md"],
        "name": "Document Markdown",
        "description": "Document Markdown (Pagina)",
        "role": "Editor"
      },
      {
        "ext": ["xmd"],
        "name": "Document Pagina",
        "description": "Document Markdown enrichi (Pagina)",
        "role": "Editor"
      }
    ]
  }
}
